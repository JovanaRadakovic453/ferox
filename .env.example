# Ferox — environment variables.
# Kopiraj u .env.local i popuni vrednostima:  cp .env.example .env.local
# (.env.local je u .gitignore — NIKAD ne commit-uj prave ključeve.)

# --- Supabase (OBAVEZNO — validira se u lib/env.ts; bez njih app pukne pri startu) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key

# --- Server-only tajne (opciono; feature-gated) ---
# Potrebno za brisanje naloga (/api/account/delete). Bez njega ruta vraća 503.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Potrebno za sve AI funkcije (Coach, brain-dump, EOD, insights, replan).
ANTHROPIC_API_KEY=sk-ant-...

# --- DeepSeek (opciono, alternativni AI provajder za Coach chat) ---
# Postavi OBA da bi Coach koristio DeepSeek umesto Anthropic-a. Ako AI_PROVIDER
# nije 'deepseek', sve ostaje na Anthropic-u (bez promene). Ključ ide u Vercel env.
DEEPSEEK_API_KEY=
AI_PROVIDER=anthropic   # ili: deepseek

# --- Google Calendar integracija (opciono; bez njih "Poveži Google" ne radi) ---
# OAuth klijent iz Google Cloud Console (redirect: {APP_URL}/api/integrations/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Push notifikacije (opciono; bez njih jutarnji podsetnik ne radi) ---
# Generiši par:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt za push servis, format mailto: adresa.
VAPID_SUBJECT=mailto:you@example.com
# Tajna kojom Vercel cron poziva /api/cron/reminders (bez nje cron vraća 401).
CRON_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
